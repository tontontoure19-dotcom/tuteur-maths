# Copiez ce fichier vers .env puis collez votre vraie clé.
# Le fichier .env n'est jamais envoyé sur GitHub (voir .gitignore).

ANTHROPIC_API_KEY=sk-ant-collez-votre-cle-ici

# Adresses autorisées à utiliser l'API (* = toutes, pour le test)
CORS_ORIGINS=*

# Codes d'accès : UN PAR TESTEUR, séparés par des virgules. Obligatoire une
# fois l'application en ligne. Lancez CODES.bat pour les fabriquer.
# Exemple : CODE_ACCES=BEPC-K7M2Q4,BEPC-R3XP9T,BAC-M4Y6ZQ
# Laissez vide en local pour travailler sans le saisir.
CODE_ACCES=

# Votre code de responsable : voit tous les élèves, tous abonnements
# confondus, sur la page parent. Fabriquez-le avec : CODES.bat ADMIN
CODE_ADMIN=

# Un abonnement = un élève. Un deuxième enfant prend son propre abonnement.
MAX_ELEVES_PAR_CODE=1

# Le budget se protège au MOIS, pas au jour : un plafond journalier coupe
# un élève en pleine révision le jour où il travaille le mieux.
# 400 questions ~ 25 000 GNF, soit un tiers d'un abonnement mensuel.
MAX_QUESTIONS_PAR_MOIS=400

# Garde-fou technique seulement (boucle, code partagé à toute une classe).
MAX_QUESTIONS_PAR_JOUR=120
