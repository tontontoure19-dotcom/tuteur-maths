# Copiez ce fichier vers .env puis collez votre vraie clé.
# Le fichier .env n'est jamais envoyé sur GitHub (voir .gitignore).

ANTHROPIC_API_KEY=sk-ant-collez-votre-cle-ici

# Adresses autorisées à utiliser l'API (* = toutes, pour le test)
CORS_ORIGINS=*

# Codes d'accès : UN PAR TESTEUR, séparés par des virgules. Obligatoire une
# fois l'application en ligne. Lancez CODES.bat pour les fabriquer.
# Exemple : CODE_ACCES=BEPC-K7M2Q4,BEPC-R3XP9T,BAC-M4Y6ZQ
# Laissez vide en local pour travailler sans le saisir.
CODE_ACCES=
